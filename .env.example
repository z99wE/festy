# ==============================================================================
# Festiya Environment Configuration Template
# ==============================================================================
# Festiya by default runs on Edge AI without requiring any API keys.
# If daily free Edge quotas/neurons expire, Festiya's resilient circuit breaker
# orchestrator will automatically cascade to any external keys you specify below.
#
# To use:
# 1. Copy this file or edit .env directly
# 2. Add your Groq (recommended for speed & high free tier) or OpenAI key
# 3. Restart Vite dev server (`npm run dev`) or build for production (`npm run build`)
# ==============================================================================

# Core Feature Flags
VITE_FEATURE_FLAGS_ENABLED=true
VITE_FLAG_PRODUCTION_READY=true

# Groq Cloud API Key (Free tier available at https://console.groq.com)
# Model used: llama-3.3-70b-versatile
VITE_GROQ_API_KEY=

# OpenAI API Key (https://platform.openai.com)
# Model used: gpt-4o-mini
VITE_OPENAI_API_KEY=

# Google Gemini API Key (https://aistudio.google.com)
# Model used: gemini-2.5-flash
VITE_GEMINI_API_KEY=

# Anthropic Claude API Key (https://console.anthropic.com)
# Model used: claude-3-5-haiku-20241022
VITE_ANTHROPIC_API_KEY=

# (Optional) Cloudflare Account Credentials for direct Workers AI calls
VITE_CF_ACCOUNT_ID=
VITE_CF_API_TOKEN=
