# Festiya Environment Configuration
# Deployment: Cloudflare Workers + D1

APP_ENV=development
APP_BASE_URL=http://localhost:5173
AUTH_SECRET=festiya_development_secret_change_in_production_32chars

# AI Gateway configuration
# Supported providers: workers-ai, groq, nvidia, fallback
AI_DEFAULT_PROVIDER=fallback
AI_FALLBACK_PROVIDER=fallback
WORKERS_AI_MODEL=@cf/meta/llama-3.3-70b-instruct
GROQ_API_KEY=
NVIDIA_NIM_API_KEY=
GEMINI_API_KEY=

# Monetisation & Billing
PAYMENT_PROVIDER=stripe
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=

# Bot Protection
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
